# Get a FREE key at https://enter.pollinations.ai/keys  (starts with sk_)
# Copy this file to ".env" and paste your key below.
POLLINATIONS_API_KEY=sk_your_key_here
# Optional: choose a model (see https://gen.pollinations.ai/image/models). Leave empty for default.
IMAGE_MODEL=

# Set a long random secret in your hosting environment
FLASK_SECRET_KEY=replace_with_a_long_random_secret
